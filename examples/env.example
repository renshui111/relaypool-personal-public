# Copy this file to .env in the repository root. No real credentials here.
# Leave empty for a direct upstream connection.
RELAYPOOL_PROXY_URL=
# Optional example for Docker Desktop: http://host.docker.internal:7890
# WorkBuddy CN chat/catalog profile: cli (default) or desktop-5.9.3.
RELAYPOOL_WORKBUDDY_IDENTITY=cli
# Optional build metadata. Leave commented to use compose.yml defaults.
# RELAYPOOL_VERSION=your-release-name
# RELAYPOOL_COMMIT=your-git-commit
